<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Gym Management System' %></title>
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>
  <nav class="navbar">
    <a href="/" class="nav-brand">
      <i class="fa-solid fa-dumbbell"></i>
      <span>FitPulse</span> Gym
    </a>

    <% if (locals.user) { %>
      <ul class="nav-links">
        <% if (user.role === 'admin') { %>
          <li><a href="/admin/dashboard" class="nav-link"><i class="fa-solid fa-chart-line"></i> Dashboard</a></li>
          <li><a href="/admin/plans" class="nav-link"><i class="fa-solid fa-tags"></i> Plans</a></li>
          <li><a href="/admin/members" class="nav-link"><i class="fa-solid fa-users"></i> Members & Trainers</a></li>
        <% } else if (user.role === 'trainer') { %>
          <li><a href="/trainer/dashboard" class="nav-link"><i class="fa-solid fa-chart-line"></i> Dashboard</a></li>
          <li><a href="/trainer/workout-plan" class="nav-link"><i class="fa-solid fa-clipboard-list"></i> Workout Plans</a></li>
        <% } else if (user.role === 'member') { %>
          <li><a href="/member/dashboard" class="nav-link"><i class="fa-solid fa-house"></i> Overview</a></li>
          <li><a href="/member/workout" class="nav-link"><i class="fa-solid fa-dumbbell"></i> My Workout</a></li>
          <li><a href="/member/weight" class="nav-link"><i class="fa-solid fa-weight-scale"></i> Weight Log</a></li>
        <% } %>
      </ul>

      <div class="nav-user">
        <span class="user-name"><%= user.name %></span>
        <span class="user-badge"><%= user.role %></span>
        <a href="/logout" class="btn btn-secondary btn-sm"><i class="fa-solid fa-right-from-bracket"></i> Logout</a>
      </div>
    <% } else { %>
      <div class="nav-links">
        <a href="/login" class="nav-link"><i class="fa-solid fa-right-to-bracket"></i> Login</a>
        <a href="/register" class="btn btn-primary btn-sm"><i class="fa-solid fa-user-plus"></i> Register</a>
      </div>
    <% } %>
  </nav>

  <main class="container">
    <% if (locals.error) { %>
      <div class="alert alert-danger">
        <span><i class="fa-solid fa-circle-exclamation"></i> <%= error %></span>
      </div>
    <% } %>

    <% if (locals.success) { %>
      <div class="alert alert-success">
        <span><i class="fa-solid fa-circle-check"></i> <%= success %></span>
      </div>
    <% } %>
