<%- include('partials/header') %>

<div class="container-narrow">
  <div class="card">
    <div class="card-header" style="justify-content: center; flex-direction: column; text-align: center;">
      <h2 class="card-title" style="font-size: 1.5rem; margin-bottom: 0.25rem;">Welcome Back</h2>
      <p class="page-subtitle">Login to access your gym dashboard</p>
    </div>

    <form action="/login" method="POST" id="loginForm">
      <div class="form-group">
        <label class="form-label" for="email">Email Address</label>
        <input type="email" name="email" id="email" class="form-control" placeholder="name@example.com" required autofocus>
      </div>

      <div class="form-group">
        <label class="form-label" for="password">Password</label>
        <input type="password" name="password" id="password" class="form-control" placeholder="Enter password" required>
      </div>

      <button type="submit" class="btn btn-primary btn-block" style="margin-top: 1rem;">
        <i class="fa-solid fa-right-to-bracket"></i> Login
      </button>
    </form>

    <div style="text-align: center; margin-top: 1.25rem; font-size: 0.9rem; color: var(--text-muted);">
      Don't have an account? <a href="/register" style="color: var(--primary); font-weight: 600;">Register here</a>
    </div>

    <div class="demo-box">
      <div class="demo-title"><i class="fa-solid fa-bolt"></i> Quick Demo Logins (Click to autofill)</div>
      <div class="demo-chips">
        <button type="button" class="demo-chip" onclick="fillCredentials('admin@gmail.com', 'admin123')">
          <i class="fa-solid fa-shield"></i> Admin
        </button>
        <button type="button" class="demo-chip" onclick="fillCredentials('trainer@gmail.com', 'trainer123')">
          <i class="fa-solid fa-user-ninja"></i> Trainer
        </button>
        <button type="button" class="demo-chip" onclick="fillCredentials('member@gmail.com', 'member123')">
          <i class="fa-solid fa-user"></i> Member
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  function fillCredentials(email, pass) {
    document.getElementById('email').value = email;
    document.getElementById('password').value = pass;
  }
</script>

<%- include('partials/footer') %>
